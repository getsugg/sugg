---
source: tests/bundle.rs
expression: "normalize(docker, &dir)"
---
//#region virtual:i18n/docker
const container_desc = "Running container";
//#endregion
//#region sugg
const unwrap = (raw, context) => {
	let parsed;
	try {
		parsed = JSON.parse(raw);
	} catch (e) {
		throw new Error(`${context}: invalid response (${e.message})`);
	}
	if (!parsed.ok) throw new Error(`${context}: ${parsed.error}`);
	return parsed.data;
};
const exec = async (cmd, options) => {
	const timeout = options?.timeout ?? 5e3;
	const raw = await globalThis.__exec(cmd, timeout);
	return unwrap(raw, `exec("${cmd}")`);
};
globalThis.__ui;
//#endregion
//#region tests/fixtures/completions/docker/__v_dyn_docker.ts
const __dyn_docker_ps_args = async () => {
	return (await exec("docker ps --format '{{.Names}}'")).split("\n").filter(Boolean).map((name) => ({
		display: name,
		description: container_desc
	}));
};
//#endregion
export { __dyn_docker_ps_args };
